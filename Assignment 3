def is_right_triangle():
    side1 = int(input("enter side 1: "))
    side2 = int(input("enter side 2: "))
    side3 = int(input("enter side 3: "))

    if side1 ** 2 + side2 ** 2 == side3 ** 2:
        print("it is right triangle")
    else:
        print("it is not right triangle")

is_right_triangle()
